# ===== 数据库 =====
# 默认使用嵌入式 SQLite（无需安装数据库，首次启动自动建表，默认文件位于 启动目录/data/fvd.db）。
# 修改 SQLite 存储路径（相对路径以启动目录为基准，绝对路径如 D:/data/clipfetch/fvd.db，目录会自动创建）：
DB_URL=jdbc:sqlite:D:/data/clipfetch/sqlite/fvd.db
# 如需切换 MySQL，取消下面 4 行注释并按实际修改（.env 配置优先于 application.yml）：
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_URL=jdbc:mysql://192.168.1.200:3308/fvd?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# DB_USER=root
# DB_PASSWORD=cpc!23#@
# MySQL 连接池建议调大（SQLite 保持默认即可）：
# DB_POOL_MAX=16
# DB_POOL_MIN=4

# ===== JWT（生产环境务必修改为随机长字符串）=====
JWT_SECRET=8fK2vQ9mL4xD7sR1tY6pH3jN5wZ0bC8aE2gU7kP4
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# ===== yt-dlp / ffmpeg / deno / aria2c =====
# 以下四行通过 %VAR% 引用系统环境变量（由 install.bat 写入，或系统属性中手动配置）：
#   FFMPEG  - ffmpeg bin 目录（音视频合并需要）
#   DENO    - deno.exe 路径（YouTube PO token/BotGuard 挑战必需）
#   ARIA2C  - aria2c.exe 路径（多线程下载加速）
#   YTDLP - yt-dlp 可执行文件路径
# 系统变量不存在时该项被跳过，回落 application.yml 默认值；也可直接改写为绝对路径覆盖。
FFMPEG_LOCATION=%FFMPEG%
JS_RUNTIME_PATH=%DENO%
ARIA2C_PATH=%ARIA2C%
YTDLP_PATH=%YTDLP%
# 单服务器并发连接数（aria2 上限 16）
ARIA2C_CONNECTIONS=16
# 出站代理，访问 YouTube/Twitter 需要，如 http://127.0.0.1:10808
PROXY_URL=http://127.0.0.1:10808

# ===== CCTV h5e 解密（Node.js 批量方案）=====
# Node.js 可执行文件路径，默认取 PATH（install.bat 已把 %NODE_HOME% 加入系统 Path）
NODE_EXE=node
# CCTV 批量解密脚本路径，默认自动查找 src/main/resources/cctv/decrypt_browser.js
CCTV_DECRYPT_SCRIPT=src/main/resources/cctv/decrypt_browser.js
# 解密超时（毫秒），45 分钟视频约 3 分钟，默认 10 分钟
CCTV_DECRYPT_TIMEOUT_MS=600000

# ===== QQ 音乐取流 sidecar（Python + Playwright + 系统 Chrome）=====
# 需先安装：Python 3.10+ 执行 pip install playwright，并在系统安装 Chrome。
# sidecar 本地服务端口
QQMUSIC_SIDECAR_PORT=8095
# Chrome 持久化用户目录（保存手机 QQ 扫码后的登录态）。
# 建议配绝对路径：否则相对路径以后端启动工作目录为基准，从不同目录启动会落到不同位置。
QQMUSIC_PROFILE_DIR=D:/data/qqmusic-profile

# ===== 酷狗音乐取流 sidecar（Python + Playwright + 系统 Chrome）=====
# sidecar 本地服务端口
KUGOU_SIDECAR_PORT=8096
# Chrome 持久化用户目录（保存酷狗扫码登录态），用绝对路径避免从不同目录启动产生重复 profile。
KUGOU_PROFILE_DIR=D:/data/kugou-profile

# ===== 腾讯视频取流 sidecar（Python + Playwright + 系统 Chrome）=====
# sidecar 本地服务端口
TENCENT_SIDECAR_PORT=8097
# Chrome 持久化用户目录（保存腾讯视频扫码登录态）。
# 用绝对路径：相对路径以后端启动工作目录为基准，从不同目录启动会落到不同位置。
TENCENT_PROFILE_DIR=D:/data/tencent-profile

# ===== SpankBang 取流 sidecar（Python + Playwright + 系统 Chrome）=====
# CF Bot Management 拦截 yt-dlp（403），由真实 Chrome 过验证后提取 CDN 直链
SPANKBANG_SIDECAR_PORT=8098
SPANKBANG_PROFILE_DIR=D:/data/spankbang-profile

# ===== 其他 =====
# 后端启动端口
SERVER_PORT=8082
# 临时下载目录：支持相对路径或绝对路径。
# 相对路径以启动时工作目录为基准（IDE/命令行运行即 backend/ 目录）；绝对路径示例：D:\data\clipfetch-downloads
DOWNLOADS_DIR=downloads
# 日志目录：支持相对路径或绝对路径（以启动目录为基准），默认 logs
LOGS_DIR=logs
PARSE_TIMEOUT=180


# ===== 字幕转换服务（RAG API）=====
# 用户在字幕转换页用自己的第三方账号连接（令牌存数据库 third_party_session 表，账号密码不落库）
SUBTITLE_API_BASE_URL=http://localhost:8085

# ===== 磁力下载（qBittorrent Web API）=====
# qBittorrent Web UI 地址（需在 qBittorrent 选项中启用 Web UI）；
# 端口注意避开 8082（后端）与 8080（字幕 RAG 服务），示例用 8085
qbt-host=http://127.0.0.1:8080
qbt-user=admin
qbt-pass=hjm029796
# 保存路径：必须是 qBittorrent 进程可见的路径；qBittorrent 跑在 Docker 中时
# 必须填容器内部路径（如 /downloads），不得传宿主机 Windows 绝对路径；留空用 qBittorrent 默认目录
QBT_SAVEPATH=/downloads
# qBittorrent 保存路径在宿主机上的对应目录（后端从此目录读取文件供浏览器下载）；
# 示例：D:\BaiduNetdiskDownload 或 D:/BaiduNetdiskDownload
QBT_DOWNLOADS_HOST_DIR=D:/BaiduNetdiskDownload
# 元数据获取超时（秒）
metadata-timeout=60
QBT_FILE_GATEWAY_URL=http://127.0.0.1:18766
QBT_FILE_GATEWAY_SECRET=i2Ons9yN0hmclthWoXj5hMZQldBRaPb3GahGRzIJI67n3HAjP8jmEhAifsqt9v0V
QBT_FILE_GATEWAY_ALLOW_HTTP=true

# ==============================================================================
# ===== Native BitTorrent 自研引擎配置（实验能力） =====
# ==============================================================================
# ---- 1. 核心开关与存储路径 ----
# 原生 BitTorrent 引擎总开关（开启后前端「磁力下载」可选择 Native 引擎）
TORRENT_NATIVE_ENABLED=true
# 原生下载文件与临时分片落盘根目录（支持绝对路径或相对后端运行目录）
TORRENT_NATIVE_STORAGE_ROOT=D:\release\clipfetch\downloads\torrent-native
# 允许用户在新建任务时选择为存储根的服务器目录白名单（英文逗号分隔的绝对路径；留空则仅允许 storage-root）
TORRENT_NATIVE_DOWNLOAD_ROOT_BASES=

# ---- 2. 控制面与工作流沙箱门禁 ----
# 是否允许前端查询磁力元数据（BEP9 info 字典解析）
TORRENT_NATIVE_METADATA_LOOKUP_ENABLED=true
# 是否允许用户通过 API 创建 Native 下载任务
TORRENT_NATIVE_TASK_CREATION_ENABLED=true
# 是否允许对任务执行暂停、恢复、重启等状态控制
TORRENT_NATIVE_TASK_CONTROL_ENABLED=true
# 受控单轮 Worker 调度开关
TORRENT_NATIVE_WORKER_ROUND_ENABLED=true
# 异步 Piece Worker 调度总开关（执行网络下载必须为 true）
TORRENT_NATIVE_ASYNC_WORKER_ENABLED=true
# 持续连续多轮自动流水线下载开关
TORRENT_NATIVE_CONTINUOUS_WORKER_ENABLED=true

# ---- 3. 并发、Actor 调度与分片吞吐加速 ----
# 是否开启多分片并行拉取（多 Actor 模式）
TORRENT_NATIVE_PARALLEL_PIECE_ENABLED=true
# 并行 Piece 下载的最大工作 Actor 线程上限（默认已放宽至 256）
TORRENT_NATIVE_PARALLEL_PIECE_WORKERS=256
# 多路复用首轮/未知 Peer 的探索 Actor 数，避免死 Peer 同时占满下载窗口
TORRENT_NATIVE_PEER_EXPLORATION_SLOTS=32
# 批量落盘与持久化事务提交的分片组大小（每组集中落盘校验，默认 256）
TORRENT_NATIVE_COMMIT_GROUP_PIECES=256
# 多路复用 Peer 监督器 Actor 邮箱通道开关（解决单连接多分片请求阻塞）
TORRENT_NATIVE_MULTIPLEXED_PEER_MAILBOX_ENABLED=true
# 同一个 Peer 在轮次与分片切换间复用 TCP 长连接，减少反复握手握紧开销
TORRENT_NATIVE_PEER_CONNECTION_REUSE_ENABLED=true

# ---- 4. Peer 寻道、数量配额与最稀缺优先 ----
# 单个任务最大连接和维护的 Peer 数目上限（提升至 256）
TORRENT_NATIVE_MAX_PEERS_PER_TASK=256
# 全局最大允许建立的 Peer TCP 连接总数
TORRENT_NATIVE_MAX_PEERS_GLOBAL=400
# 单个用户允许并发进行的活跃 Native 任务上限
TORRENT_NATIVE_MAX_ACTIVE_TASKS_PER_USER=3
# 当公开 Tracker 均无可用 Peer 时，自动启用 DHT 分布式哈希表公网兜底寻道
TORRENT_NATIVE_DHT_FALLBACK_ENABLED=true
# 最稀缺分片优先（Rarest-First）调度：根据 Peer 宣告的 Bitfield 优先下载全网罕见分片
TORRENT_NATIVE_RAREST_FIRST_ENABLED=true
# 启动时探测完整 Bitfield 的 Peer 数目
TORRENT_NATIVE_BITFIELD_PROBE_PEERS=4
# 探测单个 Peer Bitfield 宣告的超时时间（毫秒）
TORRENT_NATIVE_BITFIELD_PROBE_TIMEOUT_MILLIS=600

# ---- 5. 网络超时、心跳检测与慢节点（Straggler）踢除 ----
# 单轮网络 I/O 调度总预算时限（毫秒，超时自动切轮次结算，当前为 180000 即 180 秒）
TORRENT_NATIVE_NETWORK_ROUND_BUDGET_MILLIS=180000
# Peer BEP3 握手与 unchoke 响应超时（毫秒，默认 2000）
TORRENT_NATIVE_PEER_HANDSHAKE_TIMEOUT_MILLIS=2000
# 领到分片后无任何数据到达的静默卡死超时（毫秒，默认 8000），超时自动踢除并释放分片由快节点接管
TORRENT_NATIVE_PEER_STALL_TIMEOUT_MILLIS=8000
# 未知 Peer 首个 Block 无进展等待上限（毫秒，必须不大于上面的 stall timeout）
TORRENT_NATIVE_PEER_FIRST_BLOCK_TIMEOUT_MILLIS=6000
# 出站 TCP 建立握手连接超时（毫秒，默认 1500）
TORRENT_NATIVE_PEER_CONNECT_TIMEOUT_MILLIS=1500
# 单个 Peer 的最大在途 16 KiB Block 数，必须在 16..256 内
TORRENT_NATIVE_PEER_MAX_IN_FLIGHT_BLOCKS=128
# 失败 Peer 的指数退避上限（毫秒），必须在 250..60000 内
TORRENT_NATIVE_PEER_FAILURE_BACKOFF_MAX_MILLIS=8000

# ---- 6. 持续下载生命周期控制 ----
# 单次连续调度最大处理分片数
TORRENT_NATIVE_CONTINUOUS_MAX_PIECES=256
# 连续作业最大允许循环的总轮次数
TORRENT_NATIVE_CONTINUOUS_MAX_ROUNDS=10000
# 单次连续作业最长运行保护时限（秒，86400 即 24 小时）
TORRENT_NATIVE_CONTINUOUS_MAX_SECONDS=86400
# 连续空转（无任何新校验字节产生）被判定为停机卡死的最大轮次数
TORRENT_NATIVE_CONTINUOUS_STALLED_ROUNDS=2

# ---- 7. 实例心跳与孤儿任务崩溃自愈 ----
# 实例心跳监测，防止多实例并发冲突
TORRENT_NATIVE_INSTANCE_HEARTBEAT_ENABLED=true
# 单实例崩溃重启后，自动恢复并接管数据库中残留的 RUNNING 孤儿任务
TORRENT_NATIVE_SINGLE_INSTANCE_ORPHAN_RECOVERY_ENABLED=true
# 启动时仅审计清理过期重试租约（默认 false）
TORRENT_NATIVE_STARTUP_RETRY_LEASE_AUDIT_ENABLED=false
# 兼容旧版本单轮 Worker 模式（默认 false）
TORRENT_NATIVE_LEGACY_WORKER_COMPATIBILITY_ENABLED=false

# ---- 8. 异步执行器与任务队列 ----
# 异步 Piece 工作线程池核心线程数
TORRENT_NATIVE_ASYNC_WORKER_THREADS=2
# 异步作业等待队列容量
TORRENT_NATIVE_ASYNC_WORKER_QUEUE_SIZE=8
# 单用户允许排队的异步作业数上限
TORRENT_NATIVE_ASYNC_WORKER_PER_USER_LIMIT=2

# ---- 9. 磁力链接元数据解析（BEP9 ut_metadata）控制 ----
# 最大允许解析的种子元数据大小（字节，默认 8MB）
TORRENT_NATIVE_MAX_METADATA_BYTES=8388608
# 并发执行的磁力元数据解析任务数
TORRENT_NATIVE_METADATA_CONCURRENT_JOBS=2
# 元数据解析等待队列容量
TORRENT_NATIVE_METADATA_QUEUED_JOBS=8
# 单用户允许挂起的元数据解析任务数
TORRENT_NATIVE_METADATA_MAX_PENDING_PER_USER=2
# 单个元数据解析任务的总超时时间（秒）
TORRENT_NATIVE_METADATA_TOTAL_TIMEOUT_SECONDS=90
# 元数据解析使用的本地监听端口
TORRENT_NATIVE_METADATA_LISTEN_PORT=8001
# 单个 Magnet 解析任务最多尝试多少个 Peer 拉取 BEP9 info 字典
TORRENT_NATIVE_METADATA_PEER_ATTEMPTS=32
# 与单个 Peer 进行 ut_metadata 字典交换的单节点超时（毫秒）
TORRENT_NATIVE_METADATA_PEER_TIMEOUT_MILLIS=8000

# ---- 10. 入站 TCP 监听（可选 Inbound P4） ----
# 是否开启原生入站 TCP 监听（默认关闭，无需公网打洞）
TORRENT_NATIVE_INBOUND_TCP_ENABLED=false
# 是否向公网接口暴露入站监听（默认 false，仅内网或本机）
TORRENT_NATIVE_INBOUND_PUBLIC_EXPOSURE_ENABLED=false
# 入站 TCP 绑定监听地址
TORRENT_NATIVE_INBOUND_BIND_HOST=127.0.0.1
# 入站 TCP 监听端口
TORRENT_NATIVE_INBOUND_LISTEN_PORT=8002
