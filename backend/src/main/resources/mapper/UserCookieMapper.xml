<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fvd.cookie.domain.UserCookieMapper">

    <resultMap id="BaseResultMap" type="com.fvd.cookie.domain.UserCookie">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="platform" property="platform"/>
        <result column="content" property="content"/>
        <result column="valid" property="valid"/>
        <result column="status_message" property="statusMessage"/>
        <result column="last_verified_at" property="lastVerifiedAt"/>
        <result column="last_used_at" property="lastUsedAt"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectByUserIdAndPlatform" resultMap="BaseResultMap">
        SELECT * FROM user_cookie WHERE user_id = #{userId} AND platform = #{platform} LIMIT 1
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM user_cookie WHERE user_id = #{userId}
    </select>

</mapper>