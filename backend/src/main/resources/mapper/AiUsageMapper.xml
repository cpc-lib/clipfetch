<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fvd.auth.domain.AiUsageMapper">

    <resultMap id="BaseResultMap" type="com.fvd.auth.domain.AiUsage">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="usage_date" property="usageDate"/>
        <result column="count" property="count"/>
    </resultMap>

    <select id="selectByUserIdAndUsageDate" resultMap="BaseResultMap">
        SELECT * FROM ai_usage WHERE user_id = #{userId} AND usage_date = #{usageDate} LIMIT 1
    </select>

</mapper>