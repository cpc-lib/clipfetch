<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>com.fvd</groupId>
    <artifactId>backend</artifactId>
    <version>1.0.0</version>
    <name>backend</name>
    <description>ClipFetch - Multi-platform video downloader backend (Spring Boot + yt-dlp)</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.63.0</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.7</version>
        </dependency>
        <!-- 仅用 BCrypt 做密码哈希，不启用完整 Security 过滤链 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 默认嵌入式数据库（无需外部 MySQL），.env 配置 DB_URL/DB_DRIVER 可切换 MySQL -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.50.3.0</version>
            <scope>runtime</scope>
        </dependency>
        <!-- MySQL 数据源下用 Flyway 自动执行建表/迁移（SQLite 走 SqliteSchemaInitializer，不启用 Flyway） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>clipfetch</finalName>
        <plugins>
            <!-- ProGuard 混淆：混淆方法名/字段名，保留类名、注解、Controller 方法签名（Spring 反射安全） -->
            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>
                <version>2.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>proguard</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <proguardVersion>7.4.2</proguardVersion>
                    <injar>${project.build.finalName}.jar</injar>
                    <outjar>${project.build.finalName}-obfuscated.jar</outjar>
                    <obfuscate>true</obfuscate>
                    <attach>true</attach>
                    <appendClassifier>false</appendClassifier>
                    <!-- JDK 21 模块化：显式加入 java.base jmod，让 ProGuard 能解析 java.lang.Object 等基础类 -->
                    <libs>
                        <lib>${java.home}/jmods/java.base.jmod</lib>
                        <lib>${java.home}/jmods/java.sql.jmod</lib>
                    </libs>
                    <options>
                        <!-- 关闭优化和压缩（JDK 21/Spring Boot 3 的 fat jar 与 ProGuard 优化阶段不兼容） -->
                        <option>-dontoptimize</option>
                        <option>-dontshrink</option>
                        <!-- 忽略未解析类和成员 -->
                        <option>-dontwarn</option>
                        <option>-ignorewarnings</option>
                        <!-- 保留 Spring Boot 入口类 -->
                        <option>-keep class com.fvd.VideoDownloaderApplication { *; }</option>
                        <!-- 保留所有 Spring 注解 -->
                        <option>-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod,Record,Component</option>
                        <!-- 保留所有带注解的类和方法（Spring 反射扫描需要） -->
                        <option>-keepclassmembers class * { @org.springframework.stereotype.** *; @org.springframework.web.bind.annotation.** *; }</option>
                        <!-- 保留 Controller/Service/Component/Repository 类 -->
                        <option>-keep @org.springframework.stereotype.Component class * { *; }</option>
                        <option>-keep @org.springframework.stereotype.Service class * { *; }</option>
                        <option>-keep @org.springframework.stereotype.Repository class * { *; }</option>
                        <option>-keep @org.springframework.web.bind.annotation.RestController class * { *; }</option>
                        <option>-keep @org.springframework.context.annotation.Configuration class * { *; }</option>
                        <!-- 保留 MyBatis Mapper 接口 -->
                        <option>-keep interface com.fvd.**.domain.**Mapper { *; }</option>
                        <!-- 保留 MyBatis 实体类（domain 包下所有类，供 SQL 映射） -->
                        <option>-keep class com.fvd.**.domain.** { *; }</option>
                        <!-- 保留共享 web 包（ApiResponse 等，Jackson 序列化需要字段名） -->
                        <option>-keep class com.fvd.shared.** { *; }</option>
                        <!-- 保留 Jackson 序列化相关（JSON 响应需要字段名） -->
                        <option>-keepclassmembers class * { @com.fasterxml.jackson.annotation.** *; }</option>
                        <!-- 保留所有 record 类的字段名（JSON 序列化/反序列化依赖 record 组件名） -->
                        <option>-keepclassmembers class * extends java.lang.Record { *; }</option>
                        <!-- 保留 Lombok 生成的方法（getter/setter/builder 等） -->
                        <option>-keepclassmembers class * { *** get*(...); *** set*(...); *** is*(...); }</option>
                        <!-- 保留 JWT 相关（io.jsonwebtoken 已在依赖中，不混淆第三方） -->
                        <option>-keep class io.jsonwebtoken.** { *; }</option>
                        <!-- 保留枚举 -->
                        <option>-keepclassmembers enum * { *; }</option>
                        <!-- 保留序列化字段 -->
                        <option>-keepclassmembers class * implements java.io.Serializable { static final long serialVersionUID; private static final java.io.ObjectStreamField[] serialPersistentFields; private void writeObject(java.io.ObjectOutputStream); private void readObject(java.io.ObjectInputStream); java.lang.Object writeReplace(); java.lang.Object readResolve(); }</option>
                    </options>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>7.4.2</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- 打包完成后将 ProGuard 原始包重命名为 clipfetch_proguard.jar，清理映射文件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <move file="${project.build.directory}/clipfetch_proguard_base.jar" tofile="${project.build.directory}/clipfetch_proguard.jar"/>
                                <delete file="${project.build.directory}/proguard_map.txt"/>
                                <delete file="${project.build.directory}/proguard_seed.txt"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
