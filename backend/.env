# ===== 数据库 =====
# 默认使用嵌入式 SQLite（无需安装数据库，首次启动自动建表，文件位于 backend/data/fvd.db）。
# 如需切换 MySQL，取消下面 4 行注释并按实际修改（.env 配置优先于 application.yml）：
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_URL=jdbc:mysql://192.168.1.200:3308/fvd?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# DB_USER=root
# DB_PASSWORD=cpc!23#@
# MySQL 连接池建议调大（SQLite 保持默认即可）：
# DB_POOL_MAX=16
# DB_POOL_MIN=4

# ===== JWT（生产环境务必修改为随机长字符串）=====
JWT_SECRET=8fK2vQ9mL4xD7sR1tY6pH3jN5wZ0bC8aE2gU7kP4
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# ===== yt-dlp / ffmpeg / deno / aria2c =====
# 以下工具路径已改为读取系统环境变量（由 install.bat 写入，或在系统属性中手动配置）：
#   FFMPEG_LOCATION  - ffmpeg bin 目录（音视频合并需要）
#   JS_RUNTIME_PATH  - deno.exe 路径（YouTube PO token/BotGuard 挑战必需）
#   ARIA2C_PATH      - aria2c.exe 路径（多线程下载加速，留空则用 yt-dlp 内置单连接）
# 如需在本项目覆盖系统环境变量，取消注释并修改：
# FFMPEG_LOCATION=D:\develop\ffmpeg\bin
# JS_RUNTIME_PATH=D:\develop\deno\deno.exe
# ARIA2C_PATH=D:\develop\aria2\aria2-1.37.0-win-64bit-build1\aria2c.exe
# yt-dlp 可执行文件路径，默认取 PATH
YTDLP_PATH=yt-dlp
# 单服务器并发连接数（aria2 上限 16）
ARIA2C_CONNECTIONS=16
# 出站代理，访问 YouTube/Twitter 需要，如 http://127.0.0.1:10808
PROXY_URL=http://127.0.0.1:10808

# ===== CCTV h5e 解密（Node.js 批量方案）=====
# Node.js 可执行文件路径，默认取 PATH
NODE_EXE=node
# CCTV 批量解密脚本路径，默认自动查找 src/main/resources/cctv/decrypt_browser.js
CCTV_DECRYPT_SCRIPT=src/main/resources/cctv/decrypt_browser.js
# 解密超时（毫秒），45 分钟视频约 3 分钟，默认 10 分钟
CCTV_DECRYPT_TIMEOUT_MS=600000

# ===== 其他 =====
# 临时下载目录：支持相对路径或绝对路径。
# 相对路径以启动时工作目录为基准（IDE/命令行运行即 backend/ 目录）；绝对路径示例：D:\data\clipfetch-downloads
DOWNLOADS_DIR=downloads
PARSE_TIMEOUT=180

