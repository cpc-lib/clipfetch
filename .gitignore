# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# Node
node_modules/
.npm

# IDE
.vscode/
.trae/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# 项目临时文件
backend/downloads/
backend/logs/
backend/target/
target/
downloads/
deploy/
.trae/
*.part
*.log
logs/
*.jar
# 环境变量
.env
.env.local

# 浏览器 cookies（含登录态，严禁提交）
backend/cookies/
backend/cookie/
cookies.txt
*cookies*.txt

# QQ 音乐 sidecar 的 Chrome 用户数据目录（含扫码登录 cookie，严禁提交）
qqmusic-profile/
# 酷狗音乐 sidecar 的 Chrome 用户数据目录（含扫码登录 cookie，严禁提交）
kugou-profile/
# 腾讯视频 sidecar 的 Chrome 用户数据目录（含扫码登录 cookie，严禁提交）
tencent-profile/

# 本地数据库（SQLite）
backend/data/

# 测试目录（任意层级）
test/
tests/
__tests__/
# 测试文件：限定源码/脚本扩展名，test/Test 位于词首、词边界或驼峰结尾
# （不写裸 *test*，避免在 Windows 大小写不敏感下误伤 latest、contest 等正常文件）
Test*.*
test_*.*
*Test.java
*Test.kt
*_test.*
*-test.*

# 后端回归测试需要纳入版本控制
!backend/src/test/
!backend/src/test/**
*.test.*

# 截图等非代码文件
*.png

!server/**/src/test/
!server/**/src/test/**
!frontend/src/**/*.test.js
!frontend/e2e/
!frontend/e2e/**

# Native v2 运行时产物（.certs 含 TLS 私钥，data 含下载数据，禁止提交）
infra/native-v2/.certs/
/data/

# FTP/FTPS 测试 fixture 自签证书与私钥（运行时生成，禁止提交）
infra/ftpserver/ssl/

# aMule 运行时数据与配置密钥（包含 EC 密码与运行时状态，禁止提交）
infra/amule/data/

# aMule 运行时目录（含凭据哈希/密钥与运行态数据，仅保留 allowed-remote-dirs.dat）
infra/amule/config/*
!infra/amule/config/allowed-remote-dirs.dat
