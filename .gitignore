# 项目临时文件
backend/downloads/
backend/logs/
backend/target/
target/
downloads/
deploy/
.trae/
*.part
*.log
logs/
*.jar
# 环境变量
.env
.env.local

# 浏览器 cookies（含登录态，严禁提交）
backend/cookies/
backend/cookie/
cookies.txt
*cookies*.txt

# QQ 音乐 sidecar 的 Chrome 用户数据目录（含扫码登录 cookie，严禁提交）
qqmusic-profile/
# 酷狗音乐 sidecar 的 Chrome 用户数据目录（含扫码登录 cookie，严禁提交）
kugou-profile/
# 腾讯视频 sidecar 的 Chrome 用户数据目录（含扫码登录 cookie，严禁提交）
tencent-profile/

# 本地数据库（SQLite）
backend/data/

# 测试目录（任意层级）
test/
tests/
__tests__/
# 测试文件：限定源码/脚本扩展名，test/Test 位于词首、词边界或驼峰结尾
# （不写裸 *test*，避免在 Windows 大小写不敏感下误伤 latest、contest 等正常文件）
Test*.*
test_*.*
*Test.java
*Test.kt
*_test.*
*-test.*

# 后端回归测试需要纳入版本控制
!backend/src/test/
!backend/src/test/**
*.test.*

# 截图等非代码文件
*.png
